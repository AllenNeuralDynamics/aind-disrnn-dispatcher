# Per-user settings for Allen HPC SLURM jobs launched from the dispatcher.
#
# Copy this file to code/hpc/slurm/user.env (gitignored) and edit the values:
#
#     cp code/hpc/slurm/user.env.example code/hpc/slurm/user.env
#
# Then add one line to your ~/.bashrc so it loads in every shell:
#
#     echo 'source /path/to/aind-dynamic-foraging-bfm-dispatcher/code/hpc/slurm/user.env' >> ~/.bashrc
#
# The SBATCH_* variables are read by sbatch automatically; no extra flags
# needed. code/launch_hpc.py also reads this file before calling sbatch.
# CONDA_SH is read by the slurm scripts themselves.

# Email for SLURM mail-type=FAIL,END,BEGIN notifications.
export SBATCH_MAIL_USER="you@alleninstitute.org"

# Where SLURM should write per-job stdout/stderr. Use %j for the job id.
export SBATCH_OUTPUT="$HOME/logfile/job_%j.out"
export SBATCH_ERROR="$HOME/logfile/job_%j.err"

# Absolute path to your conda's profile.d/conda.sh (so the slurm script can
# 'source' it and then 'conda activate dynamic-foraging-bfm-cpu|gpu'). Find yours with:
#     echo "$(conda info --base)/etc/profile.d/conda.sh"
export CONDA_SH="/path/to/your/miniforge3/etc/profile.d/conda.sh"

# Where training runs write their outputs. Optional: the slurm scripts default
# to $HOME/outputs/disrnn when this is unset. $HOME here is NFS, so point this
# at scratch for write-heavy jobs. Can also be passed per-launch with
#     sbatch --export=ALL,BFM_OUTPUT_DIR=/scratch/$USER/<run> ...
# export BFM_OUTPUT_DIR="/scratch/$USER/bfm-outputs"
