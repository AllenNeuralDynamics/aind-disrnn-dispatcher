  "cards": [
    {
      "dot": "cyan",
      "title": "One interface, four variants",
      "items": [
        "Every model implements ModelTrainer.fit(bundle, loggers) and nothing else",
        "Hydra's _target_ names the class, so instantiate(cfg.model) needs no branch",
        "Adding a variant adds a config file, not a code path"
      ]
    },
    {
      "dot": "violet",
      "title": "What each variant actually fits",
      "items": [
        "GRU and disRNN train in JAX/optax through DeepMind's disentangled_rnns",
        "baseline_rl fits each session independently by maximum likelihood",
        "HB partial-pools sessions within a subject and subjects within a population"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why they are comparable",
      "items": [
        "All four report heldout/eval_likelihood: per-trial geometric-mean likelihood",
        "The same DatasetBundle, subject split and trial filters reach every trainer",
        "That shared axis is what lets a cognitive baseline sit on the GRU scaling curve"
      ]
    }
  ]
